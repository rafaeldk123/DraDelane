{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/agendarconsulta/",
      "permanent": true
    },
    {
      "source": "/agendarconsulta",
      "destination": "/agendarconsulta/",
      "permanent": true
    },
    {
      "source": "/agendarconsulta-escura",
      "destination": "/agendarconsulta-escura/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/agendarconsulta-escura/",
      "destination": "/agendarconsulta/index.html"
    }
  ]
}
